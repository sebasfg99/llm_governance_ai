# ============================================================
# .env.example — Environment variable template for ai-core
#
# INSTRUCTIONS:
#   1. Copy this file: cp .env.example .env
#   2. Fill in your actual values in .env
#   3. NEVER commit the .env file to git (it's in .gitignore)
#
# Every variable the app reads is documented here.
# ============================================================

# ------------------------------------------------------------
# Supabase — hosted Postgres + Auth + Storage backend
# Get these from: https://supabase.com → Your Project → Settings → API
# ------------------------------------------------------------
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# DON'T SHARE THIS KEY WITH ANYONE!
SUPABASE_SERVICE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# JWT signing secret. Required when callers hit the sidecar with
# a Supabase user JWT directly (Path B auth). The GovAI Edge
# Function proxy uses Path A (service key) and does not need
# this, but it's safer to set both anyway.
# Get from: Supabase → Project Settings → API → JWT Secret
SUPABASE_JWT_SECRET=

# ------------------------------------------------------------
# Service-to-service auth (Path A)
#
# Shared secret between the GovAI Supabase Edge Function proxy
# and this sidecar. The Edge Function validates the end user's
# JWT, then forwards the request with:
#
#   Authorization: Bearer ${AI_CORE_SERVICE_KEY}
#   X-Tenant-Id:   <institution_id::text>
#   X-User-Id:     <auth.users.id>
#
# Generate a fresh 32+ char random string for each environment.
# Mirror this value into Supabase Edge Function secrets via:
#   supabase secrets set AI_CORE_SERVICE_KEY=<same-value>
# ------------------------------------------------------------
AI_CORE_SERVICE_KEY=GENERATE_WITH_OPENSSL_RAND_HEX_32

# ------------------------------------------------------------
# OpenAI — used for GPT completions AND embeddings
# Get this from: https://platform.openai.com/api-keys
# ------------------------------------------------------------
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# ------------------------------------------------------------
# Google Gemini — alternative LLM provider (optional)
# ------------------------------------------------------------
GEMINI_API_KEY=

# ------------------------------------------------------------
# LLM Router — which provider and model to use by default
# LLM_DEFAULT_PROVIDER: "openai" or "gemini"
# LLM_DEFAULT_MODEL: model name for that provider
#   OpenAI examples:  gpt-4o, gpt-4o-mini, gpt-3.5-turbo
#   Gemini examples:  gemini-1.5-pro, gemini-1.5-flash, gemini-2.0-flash
# ------------------------------------------------------------
LLM_DEFAULT_PROVIDER=openai
LLM_DEFAULT_MODEL=gpt-4o-mini

# ------------------------------------------------------------
# Embedding model — used to convert text into vectors for RAG
# Dimension must match the vector(1536) column in the DB.
# ------------------------------------------------------------
EMBEDDING_MODEL=text-embedding-3-small

# ------------------------------------------------------------
# Document storage — Supabase Storage bucket name
#
# The bucket is created by migration `_ai_core_schema.sql`.
# Documents are written as: {tenant_id}/{document_id}/{filename}
# Local disk is NOT used in production (Railway / Cloud Run
# containers are ephemeral); the sidecar streams every upload
# straight to Storage.
# ------------------------------------------------------------
STORAGE_BUCKET=rag-documents

# ------------------------------------------------------------
# RAG retrieval tuning
# ------------------------------------------------------------
RETRIEVAL_TOP_K=5
SIMILARITY_THRESHOLD=0.45
CHUNK_SIZE=300
CHUNK_OVERLAP=30
RETRIEVAL_MULTILINGUAL=true

# ------------------------------------------------------------
# Application settings
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR | CRITICAL
# APP_ENV: development | sandbox | production
# ------------------------------------------------------------
LOG_LEVEL=INFO
APP_ENV=development

# ------------------------------------------------------------
# Database (for local Docker Postgres — used in docker-compose)
# These are NOT read by the FastAPI app directly (it uses Supabase).
# They configure the local Postgres container for development.
# ------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aicore
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
