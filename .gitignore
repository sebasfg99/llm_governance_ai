# ============================================================
# .gitignore — No subir secretos, datos locales ni artefactos
# ============================================================

# --- Secrets and environment (NEVER commit) ---
.env
.env.*
!.env.example
*.env.local
*.pem
*.key
credentials.json
secrets/

# --- Local documentation and private corpus (not for public repo) ---
docs/

# --- Uploaded documents (tenant data) ---
uploads/*
!uploads/.gitkeep

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.so
.mypy_cache/
.ruff_cache/
.dmypy.json
dmypy.json

# --- Virtual environments ---
.venv/
venv/
env/
ENV/
.python-version

# --- Testing / coverage ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# --- Jupyter ---
.ipynb_checkpoints/
notebooks/.ipynb_checkpoints/

# --- Build / packaging ---
*.egg-info/
.eggs/
dist/
build/
*.egg

# --- Logs and local databases ---
*.log
logs/
*.sqlite
*.sqlite3

# --- IDE / editor ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- OS ---
.DS_Store
Thumbs.db

# --- Cursor / local agent artifacts ---
.cursor/

# --- Exports that may contain prompts or PII ---
*.jsonl

# --- Eval artifacts and presentations (not needed to run RAG) ---
evals/
datasets/
*.pptx
*.pptm

# --- Docker local volumes ---
postgres_data/
