# ============================================================
# .gitignore — Files and directories excluded from git
# ============================================================

# --- Secrets and environment config (NEVER commit these) ---
.env
*.env.local

# --- Uploaded documents (private tenant data) ---
uploads/*
!uploads/.gitkeep

# --- Admin seed documents ---
# The regulatory corpus (docs/admin/**) is now versioned in this private
# repo so seed_documents.py works right after clone. If this repo ever
# becomes public, revisit licensing before keeping these tracked.

# --- Python cache files ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# --- Virtual environments ---
venv/
.venv/
env/
ENV/

# --- pytest cache ---
.pytest_cache/
.coverage
htmlcov/

# --- Jupyter notebook checkpoints ---
.ipynb_checkpoints/
notebooks/.ipynb_checkpoints/

# --- Build artifacts ---
*.egg-info/
dist/
build/

# --- IDE files ---
.vscode/
.idea/
*.swp
*.swo

# --- macOS files ---
.DS_Store

# --- Fine-tuning export files (may contain sensitive data) ---
*.jsonl

# --- Docker volumes (if using local bind mounts) ---
postgres_data/

# --- e2e validator output logs ---
validation_output.log
validation_result.txt

# --- Pre-reprocess corpus snapshots ---
backup_chunks_pre_frontmatter_*.jsonl
