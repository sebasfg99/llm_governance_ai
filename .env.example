# ============================================================
# .env.example — Environment variable template for ai-core
#
# INSTRUCTIONS:
#   1. Copy this file: cp .env.example .env
#   2. Fill in your actual values in .env
#   3. NEVER commit the .env file to git (it's in .gitignore)
#
# Every variable the app reads is documented here.
# ============================================================

# ------------------------------------------------------------
# Supabase — your hosted Postgres + Auth + Storage backend
# Get these from: https://supabase.com → Your Project → Settings → API
# ------------------------------------------------------------
SUPABASE_URL=https://oqahrrauhbleyxaianli.supabase.co

# DON'T SHARE THIS KEY WITH ANYONE!
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im9xYWhycmF1aGJsZXl4YWlhbmxpIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc3NjAzOTk4OSwiZXhwIjoyMDkxNjE1OTg5fQ._E-0X3wIobZ2lukuCl-M7R8t0TCVzxAZ5Lubrllp4uU

# ------------------------------------------------------------
# OpenAI — used for GPT completions AND embeddings
# Get this from: https://platform.openai.com/api-keys
# ------------------------------------------------------------
OPENAI_API_KEY=sk-your-openai-key-here

# ------------------------------------------------------------
# Google Gemini — alternative LLM provider
# Get this from: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------
GEMINI_API_KEY=your-gemini-key-here

# ------------------------------------------------------------
# LLM Router — which provider and model to use by default
# LLM_DEFAULT_PROVIDER: "openai" or "gemini"
# LLM_DEFAULT_MODEL: model name for that provider
#   OpenAI examples:  gpt-4o, gpt-4o-mini, gpt-3.5-turbo
#   Gemini examples:  gemini-1.5-pro, gemini-1.5-flash, gemini-2.0-flash
# ------------------------------------------------------------
LLM_DEFAULT_PROVIDER=openai
LLM_DEFAULT_MODEL=gpt-4o-mini

# ------------------------------------------------------------
# Embedding model — used to convert text into vectors for RAG
# Currently only OpenAI embeddings are supported in the MVP.
# Dimension must match the vector(1536) column in the DB.
# ------------------------------------------------------------
EMBEDDING_MODEL=text-embedding-3-small

# ------------------------------------------------------------
# File storage — where uploaded documents are saved locally
# The app creates tenant-scoped subdirectories automatically.
# Example: ./uploads/acme-corp/contract.pdf
# TODO: Replace with S3/GCS bucket path in production
# ------------------------------------------------------------
UPLOAD_DIR=./uploads

# ------------------------------------------------------------
# Application settings
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR | CRITICAL
# APP_ENV: development | staging | production
# ------------------------------------------------------------
LOG_LEVEL=INFO
APP_ENV=development

# ------------------------------------------------------------
# Database (for local Docker Postgres — used in docker-compose)
# These are NOT read by the FastAPI app directly (it uses Supabase).
# They configure the local Postgres container for development.
# ------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aicore
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
